# Credentials accepted by POST /login.
# Format per user: username:password:scope1,scope2 (scopes default to admin)
# admin sees all tools (incl. admin-only); alice sees only public tools.
MCP_USERS=admin:secret:admin,alice:wonder:user

# Secret used to sign login tokens (HS256). Use a long random value in prod.
MCP_SECRET_KEY=dev-secret-change-me
